{
  "name": "render_tree",
  "description": "Render a depth-capped, entry-capped directory tree as indented text (directories end with '/'). The complement to list_dir. Read-only.",
  "kind": "python",
  "entrypoint": "tools/scripts/render_tree.py",
  "input_schema": {
    "type": "object",
    "properties": {
      "path": {"type": "string", "description": "Directory to render (default '.')."},
      "max_depth": {"type": "integer", "description": "Max recursion depth (default 3)."},
      "max_entries": {"type": "integer", "description": "Cap on total entries rendered (default 200)."},
      "show_hidden": {"type": "boolean", "description": "Include dotfiles (default false)."},
      "dirs_only": {"type": "boolean", "description": "Show directories only (default false)."}
    }
  },
  "output_schema": {
    "type": "object",
    "required": ["path", "tree", "count", "truncated"],
    "properties": {
      "path": {"type": "string"},
      "tree": {"type": "string"},
      "count": {"type": "integer"},
      "truncated": {"type": "boolean"}
    }
  },
  "timeout_ms": 5000,
  "permission": "auto"
}
