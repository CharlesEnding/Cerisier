{
  "name": "search_steam",
  "description": "Search the Steam store for games and apps and return them as rich embed cards (name, image, price, reviews).",
  "kind": "python",
  "entrypoint": "tools/scripts/search_steam.py",
  "input_schema": {
    "type": "object",
    "required": ["query"],
    "properties": {
      "query": {"type": "string", "description": "Game or app name to search for."},
      "max_results": {"type": "integer", "description": "Number of results to return (default 10, max 50)."}
    }
  },
  "output_schema": {
    "type": "object",
    "required": ["type", "source", "query", "results", "text"],
    "properties": {
      "type": {"type": "string"},
      "source": {"type": "string"},
      "query": {"type": "string"},
      "results": {"type": "array", "items": {"type": "object"}},
      "text": {"type": "string"}
    }
  },
  "timeout_ms": 30000,
  "permission": "auto",
  "view": { "result": { "kind": "search" } },
  "path_args": []
}
