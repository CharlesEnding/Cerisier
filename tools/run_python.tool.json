{
  "name": "run_python",
  "description": "Run a snippet of Python code (via python3 -c) and return its exit code and combined stdout/stderr output. No sandboxing.",
  "kind": "python",
  "location": "local",
  "entrypoint": "tools/scripts/run_python.py",
  "input_schema": {
    "type": "object",
    "required": ["code"],
    "properties": {
      "code": {"type": "string"}
    }
  },
  "output_schema": {
    "type": "object",
    "required": ["exit_code", "output"],
    "properties": {
      "exit_code": {"type": "integer"},
      "output": {"type": "string"}
    }
  },
  "timeout_ms": 30000,
  "permission": "ask"
}
