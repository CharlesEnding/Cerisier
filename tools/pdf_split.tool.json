{
  "name": "pdf_split",
  "description": "Split a PDF into one file per page, written to an output directory.",
  "kind": "python",
  "entrypoint": "tools/scripts/pdf_split.py",
  "input_schema": {
    "type": "object",
    "required": ["input_path", "output_dir"],
    "properties": {
      "input_path": {"type": "string"},
      "output_dir": {"type": "string"},
      "prefix": {
        "type": "string",
        "description": "Filename prefix (default 'page')."
      }
    }
  },
  "output_schema": {
    "type": "object",
    "required": ["output_dir", "pages", "files"],
    "properties": {
      "output_dir": {"type": "string"},
      "pages": {"type": "integer"},
      "files": {
        "type": "array",
        "items": {"type": "string"}
      }
    }
  },
  "timeout_ms": 30000,
  "permission": "ask"
}
