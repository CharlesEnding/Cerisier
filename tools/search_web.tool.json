{
  "name": "search_web",
  "description": "Search the web and return results as rich embed cards (title, url, snippet). Uses Bing with DuckDuckGo as a fallback.",
  "kind": "python",
  "entrypoint": "tools/scripts/search_web.py",
  "input_schema": {
    "type": "object",
    "required": ["query"],
    "properties": {
      "query": {"type": "string", "description": "Search terms."},
      "max_results": {"type": "integer", "description": "Number of results to return (default 10, max 50)."},
      "engine": {"type": "string", "description": "Preferred engine: bing|duckduckgo|auto (default bing; falls back automatically)."}
    }
  },
  "output_schema": {
    "type": "object",
    "required": ["type", "source", "query", "results", "text"],
    "properties": {
      "type": {"type": "string"},
      "source": {"type": "string"},
      "query": {"type": "string"},
      "results": {"type": "array", "items": {"type": "object"}},
      "text": {"type": "string"},
      "engine": {"type": "string"}
    }
  },
  "timeout_ms": 30000,
  "permission": "auto",
  "view": { "result": { "kind": "search" } },
  "path_args": []
}
